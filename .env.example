# Modelo de configuração. Copie as variáveis que faltam para o seu .env
# e preencha os valores. Nunca coloque valores reais neste arquivo.
# Detalhes em docs/autenticacao.md.

# --- Verificação de CPF (Serpro Consulta CPF v3, serviço pago) ---
# Sem as três primeiras, as contas novas ficam com o CPF "não verificado".
SERPRO_CPF_CONSUMER_KEY=
SERPRO_CPF_CONSUMER_SECRET=
SERPRO_CPF_URL=
# SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token

# --- Consulta de CNPJ (BrasilAPI, gratuita, sem chave) ---
# CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1

# --- E-mails (Resend): link de redefinição de senha ---
RESEND_API_KEY=
EMAIL_REMETENTE=

# --- Bloom Premium e Publicidade (Mercado Pago) ---
# Sem MP_ACCESS_TOKEN nada é cobrado: as telas mostram os planos, mas
# "Assinar" e "Anunciar" respondem que os pagamentos não estão configurados.
# Use primeiro o Access Token de TESTE (Suas integrações > Credenciais de teste).
MP_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks).
MP_WEBHOOK_SECRET=
# Endereço público desta API (ex.: https://api.seusite.com/api). O Mercado Pago
# avisa em $API_PUBLIC_URL/pagamentos/mercadopago/webhook. Sem ele, o status é
# conferido quando a pessoa volta do pagamento.
API_PUBLIC_URL=
# FRONTEND_URL (já usado no projeto) define a página de volta após o pagamento.
# MP_API_URL só existe para testes automatizados com um servidor simulado.
