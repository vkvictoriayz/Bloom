# Modelo de configuração. Copie as variáveis que faltam para o seu .env
# e preencha os valores. Nunca coloque valores reais neste arquivo.
# Detalhes em docs/autenticacao.md.

# --- Verificação de CPF (Serpro Consulta CPF v3, serviço pago) ---
# Sem as três primeiras, as contas novas ficam com o CPF "não verificado".
SERPRO_CPF_CONSUMER_KEY=
SERPRO_CPF_CONSUMER_SECRET=
SERPRO_CPF_URL=
# SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token

# --- Consulta de CNPJ (BrasilAPI, gratuita, sem chave) ---
# CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1

# --- E-mails (Resend): link de redefinição de senha ---
RESEND_API_KEY=
EMAIL_REMETENTE=
